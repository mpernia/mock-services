@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(httplib CONFIG REQUIRED)
find_dependency(pugixml CONFIG REQUIRED)
find_dependency(Threads REQUIRED)

if(MINGW AND EXISTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libcryptui.a")
    link_directories("${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mock-servicesTargets.cmake")

check_required_components(mock-services)
